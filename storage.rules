rules_version = '2';

// Catalog images (products, categories, home banners) are public; only
// admins (custom claim `admin: true`, granted by
// functions/scripts/set-admin.ts) may upload or replace them. Nothing
// else lives in Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /catalog/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
