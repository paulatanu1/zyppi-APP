rules_version = '2';

// Catalog images (products, categories, home banners) are public; only
// catalog staff (custom claim `role`, or the legacy `admin: true` =
// super_admin — see firestore.rules) may upload or replace them.
service firebase.storage {
  match /b/{bucket}/o {
    function catalogStaff() {
      return request.auth != null
        && (request.auth.token.get('admin', false) == true
            || request.auth.token.get('role', null) in ['super_admin', 'catalog']);
    }

    // Rider KYC (Aadhaar, licence, RC, selfie): never public. The rider
    // uploads their own; operations staff can view them for verification.
    match /riders/{uid}/kyc/{file} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.get('admin', false) == true
            || request.auth.token.get('role', '') in ['super_admin', 'ops']);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if false;
    }

    // Home banners: public, uploaded from the admin Banners page.
    match /banners/{file} {
      allow read: if true;
      allow write: if catalogStaff()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if catalogStaff();
    }

    // Push notification pictures (shown in the notification shade).
    match /notifications/{file} {
      allow read: if true;
      allow write: if catalogStaff()
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if catalogStaff();
    }

    match /catalog/{path=**} {
      allow read: if true;
      allow write: if catalogStaff()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if catalogStaff();
    }
  }
}
