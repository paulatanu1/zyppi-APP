<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is copied to Google Drive backups or to a new
     phone. App data holds the sign-in session and cached personal data
     (addresses, orders, KYC, bank details); the user signs in again on a
     new device instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
